root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
max_line_length = 140

# Android Studio's formatting conventions rather than ktlint's own opinionated
# style, so the gate matches what the IDE produces and does not demand a
# wholesale reformat of existing code.
ktlint_code_style = android_studio

# @Composable functions are PascalCase by convention (ScoreScreen, SplashScreen).
# ktlint's standard rule only knows plain Kotlin naming and flags every one of them.
ktlint_standard_function-naming = disabled

# The theme files align their constants into columns on purpose; this rule would
# collapse that alignment into single spaces.
ktlint_standard_no-multi-spaces = disabled

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2
